# Database — omit to fall back to SQLite at cms/db.sqlite3.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Absolute base URL of this CMS. Used in outbound emails, admin
# notification links, and (for GraphQL responses with no request
# context) absolute image / document URLs. Don't include /admin or a
# trailing slash.
# WAGTAILADMIN_BASE_URL=http://localhost:8000

# Base URL of the Next.js frontend. Used by wagtail-headless-preview
# to send the admin's "preview" button at the right host.
# SERVE_BASE_URL=http://localhost:3000

# ---- Production only ----
# SECRET_KEY=change-me
# ALLOWED_HOSTS=cms.example.com,admin.example.com
# CSRF_TRUSTED_ORIGINS=https://cms.example.com

# ---- Media storage (S3) ----
# Leave AWS_STORAGE_BUCKET_NAME unset (or empty) to keep media on the
# local filesystem at cms/media/. Setting it flips uploads to S3 (or
# any S3-compatible service via the endpoint/region overrides below).
# Credentials come from the standard boto3 chain — env vars, instance
# profile, task role — so no keys need to live here.
# AWS_STORAGE_BUCKET_NAME=my-media-bucket
# AWS_S3_REGION_NAME=ap-southeast-2
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.example.com
# AWS_S3_QUERYSTRING_AUTH=false

# Standard boto3 credentials (only needed when not using an instance
# role / task role / gcloud auth):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
